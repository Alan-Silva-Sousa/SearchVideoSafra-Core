NODE_ENV=development
PORT=3000

# PostgreSQL executado pelo docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=searchvideo
DB_USERNAME=searchvideo
DB_PASSWORD=searchvideo_dev
DB_SCHEMA=searchvideo
APP_DOMAIN=searchaudio-safra.s4me.app
FRONT_URL=https://searchaudio-safra.s4me.app
GENESYS_FRAME_ANCESTORS=https://*.pure.cloud
AUDIT_READER_GENESYS_GROUP_IDS=
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_REGION=sae1.pure.cloud
AWS_REGION=us-east-1
AWS_S3_BUCKET=safra-search-audio-e-video
DB_SSL=false

# Pipeline canônico Genesys -> PostgreSQL/S3
HOME_DIVISION_ID=
METADATA_CONCURRENCY=5
METADATA_CRON_ENABLED=true
METADATA_CRON_SCHEDULE=0 2 * * *
METADATA_RUN_ON_STARTUP=false
METADATA_BACKFILL=false
METADATA_BACKFILL_START=
METADATA_BACKFILL_END=
METADATA_MAX_WINDOW_DAYS=1
METADATA_JOB_PAUSE_MS=3000

# Piloto Genesys Batch Download -> S3
EXPORT_PILOT_START=
EXPORT_PILOT_END=
EXPORT_CONVERSATION_ID=
EXPORT_POLL_INTERVAL_MS=30000
